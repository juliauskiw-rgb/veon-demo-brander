---
// «Що кажуть клієнти»: the only dark band. Five companies from C-006, a real poster from the current landing,
// video is not embedded: the poster and the button lead to the confirmed YouTube channel.
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { reviews, socials } from "../data/site";
const youtube = socials.find((s) => s.name === "YouTube")!.href;
---
<section id="reviews" class="reviews section tone-dark" data-rec="SM-R013" aria-labelledby="reviews-title">
  <div class="container reviews__grid">
    <a class="poster" href={youtube} target="_blank" rel="noopener" aria-label="Відеовідгуки клієнтів на YouTube-каналі Brander">
      <picture>
        <source srcset="/img/review-zolotyi-vik.avif" type="image/avif" />
        <img src="/img/review-zolotyi-vik.webp" alt="Кадр відеовідгуку компанії Золотий Вік" width="832" height="468" loading="lazy" decoding="async" data-rec="P-R002,P-R006,S-R006" />
      </picture>
      <span class="poster__cap"><Icon name="youtube" size={22} />Золотий Вік, відеовідгук</span>
    </a>
    <div class="reviews__body">
      <h2 id="reviews-title">Що кажуть клієнти</h2>
      <p class="section__lead">Відеовідгуки записали клієнти, з якими ми працювали. Дивіться їх на нашому YouTube-каналі.</p>
      <ul class="reviews__list">
        {reviews.map((r) => <li>{r}</li>)}
      </ul>
      <Button href={youtube} icon="youtube" external>Дивитися відгуки на YouTube</Button>
    </div>
  </div>
</section>

<style>
  .reviews__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-5); align-items: center; }
  .poster { position: relative; display: block; color: var(--color-on-accent); text-decoration: none; overflow: hidden; border-radius: var(--radius); }
  .poster img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .poster:hover .poster__cap { background: var(--color-on-accent); color: var(--color-text); }
  .poster__cap { position: absolute; left: var(--s-2); bottom: var(--s-2); min-height: var(--tap); display: inline-flex; align-items: center; gap: 0.5rem; padding: 0 var(--s-2); background: var(--color-accent); color: var(--color-accent-ink); font-size: var(--fs-small); font-weight: 600; border-radius: var(--radius); transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .reviews__body { display: grid; gap: var(--s-3); justify-items: start; }
  .reviews__list { display: grid; width: 100%; border-top: 1px solid var(--color-text-muted); }
  .reviews__list li { padding-block: 0.75rem; border-bottom: 1px solid var(--color-text-muted); font: 500 1.25rem/1.3 var(--font-display); font-variation-settings: var(--display-axes); }
  @media (min-width: 1024px) {
    .reviews__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-6); }
  }
</style>
