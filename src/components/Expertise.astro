---
// «Що підключаємо до вашого сайту»: the six nodes of the hero bus unfolded (C-010). Replaces «Переваги» + «Експертиза».
import { expertise } from "../data/site";
---
<section id="expertise" class="expertise section tone-surface" data-rec="U-R009,U-R008" aria-labelledby="expertise-title">
  <div class="container">
    <div class="section__head">
      <h2 id="expertise-title">Що підключаємо до вашого сайту</h2>
      <p class="section__lead">Сайт працює як вузол: технології, дизайн, керування, інтеграції, швидкість і безпека збираються в одну систему.</p>
    </div>
    <ol class="expertise__list">
      {expertise.map((e) => (
        <li id={e.id} class="expertise__item" tabindex="-1">
          <span class="node-mark" aria-hidden="true"></span>
          <h3>{e.title}</h3>
          <p>{e.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .expertise__list { display: grid; position: relative; }
  .expertise__item { position: relative; display: grid; gap: var(--s-1); padding: 0 0 var(--s-4) calc(var(--node) + var(--s-3)); outline-offset: 6px; }
  .expertise__item::before { content: ""; position: absolute; left: calc(var(--node) / 2 - 1px); top: 0.5rem; bottom: -0.5rem; width: var(--line); background: var(--color-accent); }
  .expertise__item:last-child::before { display: none; }
  .expertise__item .node-mark { position: absolute; left: 0; top: 0.5rem; color: var(--color-accent); background: var(--color-surface); z-index: 1; }
  .expertise__item:hover .node-mark, .expertise__item:target .node-mark { background: var(--color-accent); }
  .expertise__item h3 { font-size: var(--fs-h3); }
  .expertise__item p { color: var(--color-text-muted); max-width: 30rem; }

  @media (min-width: 1024px) {
    .expertise__list { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-flow: column; grid-template-rows: repeat(3, auto); column-gap: var(--s-6); }
    .expertise__item { padding-bottom: var(--s-5); }
    .expertise__item:nth-child(3)::before { display: none; }
  }
</style>
