---
// «Як працюємо і як рахуємо вартість»: 7 open stations on one line (C-011), price note next to «Оцінка».
// Effect 4: the line draws once when the block enters the screen (reveal.ts adds .is-visible).
import Button from "./Button.astro";
import { contacts, process } from "../data/site";
---
<section id="process" class="process section" data-rec="U-R013" aria-labelledby="process-title">
  <div class="container">
    <div class="section__head">
      <h2 id="process-title">Як працюємо і як рахуємо вартість</h2>
      <p class="section__lead">Сім кроків від першої розмови до вдосконалення сайту після запуску. Кожен крок видно одразу, без прихованих розділів.</p>
    </div>
    <ol class="track" data-reveal>
      {process.map((s, i) => (
        <li class:list={["station", s.note && "station--noted"]} style={`--i:${i}`}>
          <span class="station__num num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="node-mark station__mark" aria-hidden="true"></span>
          <h3 class="station__title">{s.title}</h3>
          <p class="station__text">{s.text}</p>
          {s.note && <p class:list={["station__note", i === 0 && "station__note--soft"]}>{s.note}</p>}
        </li>
      ))}
      <span class="track__line" aria-hidden="true"></span>
    </ol>
    <p class="process__price"><span class="process__price-k">02 Оцінка</span>{process[1].note}</p>
    <div class="process__cta">
      <Button href={contacts.telegram} icon="telegram" external rec="U-R013">Запитати оцінку в Telegram</Button>
    </div>
  </div>
</section>

<style>
  .track { position: relative; display: grid; gap: var(--s-4); padding-left: calc(var(--node) + var(--s-3)); }
  .track__line { position: absolute; left: calc(var(--node) / 2 - 1px); top: 0.5rem; bottom: 1rem; width: var(--line); background: var(--color-accent); transform-origin: top; }
  .station { position: relative; display: grid; gap: var(--s-1); align-content: start; }
  .station__mark { position: absolute; left: calc(-1 * (var(--node) + var(--s-3))); top: 0.45rem; color: var(--color-accent); background: var(--color-bg); z-index: 1; }
  .station__num { font: 500 var(--fs-small)/1 var(--font-body); color: var(--color-text-muted); }
  .station__title { font-size: var(--fs-h3); }
  .station__text { color: var(--color-text-muted); }
  .station__note { padding: var(--s-2); background: var(--color-surface); border-left: var(--line) solid var(--color-accent); color: var(--color-text); }
  .station--noted:nth-child(2) .station__mark { background: var(--color-accent); }
  .station__note--soft { padding: 0; background: none; border: 0; font-size: var(--fs-small); color: var(--color-text-muted); }
  .process__price { display: none; }
  .process__cta { margin-top: var(--s-5); }

  @media (min-width: 1280px) {
    .track { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: var(--s-3); padding: var(--s-5) 0 0; }
    .track__line { left: 0; right: 0; top: calc(var(--s-5) + 1.5rem + var(--node) / 2 - 1px); bottom: auto; width: auto; height: var(--line); transform-origin: left; }
    .station { grid-template-rows: auto auto auto 1fr; }
    .station__mark { position: static; margin: var(--s-2) 0 var(--s-1); }
    .station__title { font-size: 1.1875rem; overflow-wrap: normal; }
    .station__text { font-size: 0.9375rem; }
    .station:nth-child(2) .station__note { display: none; }
    .station__note--soft { font-size: var(--fs-small); }
    .process__price { position: relative; display: grid; gap: 0.25rem; margin: var(--s-4) 0 0 calc((100% - 6 * var(--s-3)) / 7 + var(--s-3)); max-width: 36rem; padding: var(--s-3); background: var(--color-surface); border-left: var(--line) solid var(--color-accent); font-size: var(--fs-lead); line-height: 1.45; }
    .process__price-k { font: 600 var(--fs-small)/1.3 var(--font-body); color: var(--color-accent); }
  }

  /* Effect 4: the line draws, stations appear in order. Override the base reveal (no translate on the whole list). */
  .track[data-reveal] { opacity: 1; transform: none; transition: none; }
  :global(.js) .track:not(.is-visible) { opacity: 1; transform: none; }
  :global(.js) .track:not(.is-visible) .track__line { transform: scaleY(0); }
  :global(.js) .track:not(.is-visible) .station { opacity: 0; }
  .track__line { transition: transform 600ms var(--ease-out); }
  .station { transition: opacity 400ms var(--ease-out); }
  @media (min-width: 1280px) {
    :global(.js) .track:not(.is-visible) .track__line { transform: scaleX(0); }
    .track__line { transition-duration: 900ms; }
    .station { transition-delay: calc(150ms + var(--i) * 50ms); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .track:not(.is-visible) .track__line { transform: none; }
    :global(.js) .track:not(.is-visible) .station { opacity: 1; }
    .track__line, .station { transition: none; }
  }
</style>
